[Unit]
Description=Dictate development daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=notify
Environment=DICTATE_CAPTURE_DIR=%h/.local/state/dictate-dev/captures
ExecStart=%h/.local/bin/dictate-dev daemon --background
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
