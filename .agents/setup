#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

echo "==> Checking native dependencies (Debian equivalents of the CI packages)"
packages=(
    build-essential ca-certificates clang cmake glslc
    libasound2-dev libfontconfig-dev libglib2.0-dev libssl-dev
    libva-dev libvulkan-dev libvulkan1 libwayland-dev
    libx11-xcb-dev libxkbcommon-dev libxkbcommon-x11-dev libzstd-dev
    libpulse-dev lld llvm pkg-config wtype
)
missing=()
for package in "${packages[@]}"; do
    if [[ $(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true) != "install ok installed" ]]; then
        missing+=("$package")
    fi
done
if ((${#missing[@]})); then
    sudo apt-get update -qq
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

if ! command -v mise >/dev/null 2>&1; then
    echo "==> Installing mise"
    curl --proto '=https' --tlsv1.2 -LsSf https://mise.run | sh
fi

echo "==> Installing pinned development tools"
mise trust "$repo_root/mise.toml"
mise install
mise -C tools/rustfmt install rust

# Orb login shells prefer ~/.local/bin, and Cargo also searches CARGO_HOME/bin
# before PATH. Keep the project-selected tools authoritative in both places.
cargo_home="${CARGO_HOME:-$HOME/.cargo}"
mkdir -p "$HOME/.local/bin" "$cargo_home/bin"
for tool in cargo-hawk just prek uv zizmor; do
    ln -sf "$(mise which "$tool")" "$HOME/.local/bin/$tool"
done
ln -sf "$(mise which cargo-hawk)" "$cargo_home/bin/cargo-hawk"

# Node is supplied by the Orb base image. Tests have no npm dependencies;
# npm install would unnecessarily install the Pi host peer dependency.
node --experimental-strip-types -e 'if (Number(process.versions.node.split(".")[0]) < 22) process.exit(1)'

echo "==> Fetching locked Cargo dependencies for this orb's target"
host=$(rustc -vV | sed -n 's/^host: //p')
cargo fetch --locked --target "$host"

echo "==> Installing pre-commit hooks and their environments"
prek install --prepare-hooks

echo "==> Ready (compilation and optional speech-model downloads remain on demand)"
